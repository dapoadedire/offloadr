# Server Configuration
ADDR=:8080
GO_ENV=development
VERSION=v1
API_VERSION=/v1

# Server Timeouts (duration format: 5s, 10m, 1h)
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_ADDR=postgres://offloadr:password@localhost:5432/offloadr?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m
