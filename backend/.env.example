# Server Configuration
ADDR=:8080
GO_ENV=development
VERSION=v1
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Database Configuration
DB_ADDR=postgres://offloadr:password@localhost:5432/offloadr?sslmode=disable
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=30
DB_MAX_IDLE_TIME=15m

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_AUDIENCE=offloadr-users
JWT_ISSUER=offloadr-api
JWT_EXPIRY=168h

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=noreply@offloadr.com

# Redis (Optional - for rate limiting)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS_PER_WINDOW=20
RATE_LIMITER_WINDOW=60s

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
